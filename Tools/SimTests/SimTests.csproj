<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the Unity EditMode tests of the pure simulation code (no MonoBehaviours, no physics)
    with plain `dotnet test`, using the UnityShim folder instead of UnityEngine.
    Unity itself ignores this folder (it lives outside Assets/).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);POLYKOV_SIM_TESTS</DefineConstants>
    <NoWarn>$(NoWarn);CS0660;CS0661</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UnityShim/**/*.cs" />
    <!-- Pure simulation sources. ScriptableObject wrappers are Unity-only and excluded. -->
    <Compile Include="../../Assets/_Project/Scripts/Movement/**/*.cs" Exclude="../../Assets/_Project/Scripts/Movement/MovementSettings.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Weapons/Simulation/**/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Animation/IK/TwoBoneIKSolver.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Audio/SoundSynth.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Combat/Simulation/**/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Netcode/**/*.cs" Exclude="../../Assets/_Project/Scripts/Netcode/Unity/**" />
    <Compile Include="../../Assets/_Project/Scripts/Inventory/Simulation/**/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Raid/Simulation/**/*.cs" />
    <Compile Include="../../Assets/_Project/Tests/EditMode/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
